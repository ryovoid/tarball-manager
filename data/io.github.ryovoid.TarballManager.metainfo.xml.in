<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ryovoid.TarballManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Tarball Manager</name>
  <summary>Install Linux app tarballs</summary>
  <description>
    <p>Tarball Manager takes a Linux app tarball and turns it into a proper desktop application with a launcher, icon, and menu entry.</p>
  </description>
  <developer id="io.github.ryovoid">
    <name>ryovoid</name>
  </developer>
  <url type="homepage">https://github.com/ryovoid/tarball-manager</url>
  <url type="bugtracker">https://github.com/ryovoid/tarball-manager/issues</url>
  <translation type="gettext">tarball_manager</translation>
  <launchable type="desktop-id">io.github.ryovoid.TarballManager.desktop</launchable>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#818cf8</color>
    <color type="primary" scheme_preference="dark">#6366f1</color>
  </branding>
  <releases>
    <release version="0.1.5" date="2026-09-02">
      <description translate="no">
        <p>A redesigned interface:</p>
        <ul>
          <li>The app follows your system accent colour and light or dark preference, and adapts down to narrow windows</li>
          <li>The library shows every installed app with its icon, update badge and search</li>
          <li>A tarball can be dropped anywhere on the window</li>
          <li>The install wizard keeps its next action in view, and offers to launch what it just installed</li>
          <li>App details lead with the app itself, with Launch and copyable install paths</li>
          <li>Keyboard shortcuts, and the window reopens at the size you left it</li>
        </ul>
      </description>
    </release>
    <release version="0.1.4" date="2026-09-02">
      <description translate="no">
        <p>Application version detection fixes:</p>
        <ul>
          <li>Electron apps that nest their bundle a directory deeper, as Postman does, no longer show an Unknown version</li>
          <li>Apps that keep package.json packed inside app.asar have their version read out of the archive</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2026-09-02">
      <description translate="no">
        <p>Further icon detection fixes:</p>
        <ul>
          <li>Sprite sheets and bundler artwork no longer beat the real application icon</li>
          <li>Icons kept in an assets directory, as Postman and other Electron apps do, are found again</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-08-30">
      <description translate="no">
        <p>Fixes for application icons and taskbar identity:</p>
        <ul>
          <li>Icon detection no longer picks SVGs that only wrap a bitmap, which installed as a dark square</li>
          <li>Generated desktop entries carry StartupWMClass, so the running window shows the app icon in the taskbar on Wayland</li>
          <li>Desktop entries are named after the app id the window reports</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-28">
      <description translate="no">
        <p>Initial release</p>
      </description>
    </release>
  </releases>
</component>
