<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Tarball Manager</vendor>
  <vendor_url>https://github.com/ryovoid/tarball-manager</vendor_url>

  <action id="io.github.ryovoid.TarballManager.install-system">
    <description>Install an application system-wide</description>
    <message>Authentication is required to install an application for all users</message>
    <icon_name>io.github.ryovoid.TarballManager</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/tarball_manager/install_helper.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="io.github.ryovoid.TarballManager.uninstall-system">
    <description>Uninstall a system-wide application</description>
    <message>Authentication is required to remove a system-wide application</message>
    <icon_name>io.github.ryovoid.TarballManager</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/tarball_manager/install_helper.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
